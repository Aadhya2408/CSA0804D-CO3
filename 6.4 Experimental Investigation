import random
import time

stations = ['Station' + str(i) for i in range(200)]

def build(n_trains):
    data = {}
    for i in range(n_trains):
        route = random.sample(stations, 10)
        stops = [(s, '08:00', '08:05') for s in route]
        data[str(10000 + i)] = {'name': 'Train' + str(i), 'stops': stops,
                                'days': {'Mon', 'Wed'}}
    return data

