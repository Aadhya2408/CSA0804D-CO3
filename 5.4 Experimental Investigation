import sys
import time

n = 1_000_000
t0 = time.perf_counter()
lst = [x * 9 / 5 + 32 for x in range(n) if x % 3 == 0]
t1 = time.perf_counter()
gen = (x * 9 / 5 + 32 for x in range(n) if x % 3 == 0)
t2 = time.perf_counter()
total_lst = sum(lst)
t3 = time.perf_counter()
total_gen = sum(gen)
t4 = time.perf_counter()

print('List comprehension: build', round(t1 - t0, 4), 's | memory',
      sys.getsizeof(lst), 'bytes')
print('Generator expression: create', round(t2 - t1, 6), 's | memory',
      sys.getsizeof(gen), 'bytes')
print('sum(list):', round(t3 - t2, 4), 's | sum(generator):', round(t4 - t3, 4), 's')
print('Same total:', abs(total_lst - total_gen) < 1e-3)
