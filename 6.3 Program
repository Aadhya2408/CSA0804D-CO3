timetable

def sort_key(row):                                  # row = (train no, name, arrival, departure)
    return row[3] if row[3] != '--' else row[2]

def trains_at(station, day):
    result = []
    for number, info in timetable.items():
        if day in info['days']:
            for st, arr, dep in info['stops']:
                if st == station:
                    result.append((number, info['name'], arr, dep))
    return sorted(result, key=sort_key)

def show(rows, station, day):
    print('Trains at', station, 'on', day)
    print('%-8s %-24s %-8s %-8s' % ('Train', 'Name', 'Arrival', 'Departs'))
    for number, name, arr, dep in rows:
        print('%-8s %-24s %-8s %-8s' % (number, name, arr, dep))

print('Third stop departure of 12163:', timetable['12163']['stops'][2][2])    # 23:10
show(trains_at('Villupuram', 'Mon'), 'Villupuram', 'Mon')


# ----------- Station index -----------
station_index = {}
for number, info in timetable.items():
    for st, arr, dep in info['stops']:
        station_index.setdefault(st, []).append(number)

def trains_at_indexed(station, day):
    result = []
    for number in station_index.get(station, []):
        info = timetable[number]
        if day in info['days']:
            for st, arr, dep in info['stops']:
                if st == station:
                    result.append((number, info['name'], arr, dep))
    return sorted(result, key=sort_key)

print('Index entry for Villupuram:', station_index['Villupuram'])
print('Index gives same answer:', trains_at('Villupuram', 'Mon') ==
      trains_at_indexed('Villupuram', 'Mon'))
