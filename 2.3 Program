# ---------- 3. Aliasing, shallow copy, deep copy ----------
original = [[1, 2], [3, 4]]
alias = original
shallow1 = copy.copy(original)
shallow2 = original[:]
deep = copy.deepcopy(original)

original[0][0] = 99         # change an INNER list
original.append([5, 6])     # change the OUTER list
print('original:', original)    # [[99, 2], [3, 4], [5, 6]]
print('alias    :', alias)        # same as original
print('shallow1:', shallow1)    # [[99, 2], [3, 4]] (inner shared, outer separate)
print('shallow2:', shallow2)    # [[99, 2], [3, 4]]
print('deep    :', deep)        # [[1, 2], [3, 4]] (fully independent)
