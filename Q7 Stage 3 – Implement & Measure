# ('Karthik', [], [])

# ---------- More edge cases ----------
bridge = [{'name': 'A', 'numbers': ['9111111111']},
          {'name': 'B', 'numbers': ['9222222222']},
          {'name': 'C', 'numbers': ['9111111111', '9222222222']}]    # C links A and B
print('Bridging test (expect 1):', len(merge_contacts(bridge)))
print('Empty input (expect 0):', len(merge_contacts([])))
print('Invalid number kept separate (expect 2):',
      len(merge_contacts([{'name': 'X', 'numbers': ['12345']}, {'name': 'X', 'numbers': ['12345']}])))
print('Missing fields (expect 1):', len(merge_contacts([{'numbers': ['9333333333']},
                                                       {'name': 'Q', 'numbers': ['9333333333']}])))
